<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SampClient" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Tombol di panel kiri atas -->
    <!-- Catatan: layout_width/height & margin tetap ditulis di XML agar tidak bergantung pada style -->
    <style name="AuthButton" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Tombol utama MAIN -->
    <style name="PlayButton" parent="AuthButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.35</item>
    </style>

</resources>
