<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml
    Root: ConstraintLayout
      1. Gambar latar UI utama  -> ivBackground
      2. Konten utama           -> mainContent (muncul setelah loading selesai)
           - tvServerName  : teks nama server, tengah atas (animasi floating)
           - authGroup     : pojok kiri atas (Login Google / Logout / MAIN)
           - tvStatus      : indikator status koneksi di bawah
      3. Splash screen + loading -> splashContainer (ditutup otomatis)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ===================== BACKGROUND IMAGE ===================== -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_gradient"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Supaya teks tetap terbaca di atas foto -->
    <View
        android:id="@+id/scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===================== KONTEN UTAMA ===================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ======== 4. NAMA SERVER (TENGAH ATAS) ======== -->
        <TextView
            android:id="@+id/tvServerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:text="@string/server_name"
            android:textColor="@color/accent"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvServerSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.15"
            android:text="@string/server_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvServerName" />

        <!-- ======== 3. POJOK KIRI ATAS: LOGIN / LOGOUT / MAIN ======== -->
        <LinearLayout
            android:id="@+id/authGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/panel_bg"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Tombol Login dengan Google (tampil bila belum login) -->
            <Button
                android:id="@+id/btnGoogleSignIn"
                style="@style/AuthButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_google"
                android:backgroundTint="@null"
                android:text="@string/login_with_google"
                android:textColor="@color/google_btn_text" />

            <!-- Tombol Logout (tampil setelah berhasil login) -->
            <Button
                android:id="@+id/btnLogout"
                style="@style/AuthButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_logout"
                android:backgroundTint="@null"
                android:text="@string/logout"
                android:textColor="@color/danger"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Tombol utama MAIN — tepat di bawah tombol Logout -->
            <Button
                android:id="@+id/btnMain"
                style="@style/PlayButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_main"
                android:backgroundTint="@null"
                android:text="@string/main_play"
                android:textColor="@color/background"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Tombol UPDATE DATA: cek & unduh aset game -->
            <Button
                android:id="@+id/btnUpdate"
                style="@style/UpdateButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_update"
                android:backgroundTint="@null"
                android:text="@string/update_check"
                android:textColor="@color/accent" />

            <TextView
                android:id="@+id/tvDataVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/update_data_none"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ======== AKSI CEPAT ROLEPLAY ======== -->
        <LinearLayout
            android:id="@+id/roleplayPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/panel_bg"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintBottom_toTopOf="@id/tvStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvQuickActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="@string/quick_action_title"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/roleplayActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnActionMe"
                        style="@style/QuickActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/btn_quick"
                        android:backgroundTint="@null"
                        android:text="@string/action_me"
                        android:textColor="@color/accent" />

                    <Button
                        android:id="@+id/btnActionDo"
                        style="@style/QuickActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/btn_quick"
                        android:backgroundTint="@null"
                        android:text="@string/action_do"
                        android:textColor="@color/accent" />

                    <Button
                        android:id="@+id/btnActionOoc"
                        style="@style/QuickActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/btn_quick"
                        android:backgroundTint="@null"
                        android:text="@string/action_ooc"
                        android:textColor="@color/accent" />

                    <Button
                        android:id="@+id/btnActionB"
                        style="@style/QuickActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/btn_quick"
                        android:backgroundTint="@null"
                        android:text="@string/action_b"
                        android:textColor="@color/accent" />

                    <Button
                        android:id="@+id/btnActionReport"
                        style="@style/QuickActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/btn_quick"
                        android:backgroundTint="@null"
                        android:text="@string/action_report"
                        android:textColor="@color/accent" />

                    <Button
                        android:id="@+id/btnActionStats"
                        style="@style/QuickActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/btn_quick"
                        android:backgroundTint="@null"
                        android:text="@string/action_stats"
                        android:textColor="@color/accent" />

                    <Button
                        android:id="@+id/btnActionInventory"
                        style="@style/QuickActionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_quick"
                        android:backgroundTint="@null"
                        android:text="@string/action_inventory"
                        android:textColor="@color/accent" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- ======== STATUS KONEKSI ======== -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:background="@drawable/panel_bg"
            android:letterSpacing="0.05"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/status_login_required"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ===================== 1. SPLASH SCREEN + LOADING ===================== -->
    <FrameLayout
        android:id="@+id/splashContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/splash_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSplashTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.12"
                android:text="@string/splash_title"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvSplashSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.4"
                android:text="@string/splash_subtitle"
                android:textColor="@color/accent"
                android:textSize="12sp" />

            <!-- Loading animation (halus, tanpa aset tambahan).
                 Ingin memakai Lottie? Ganti ProgressBar ini dengan
                 com.airbnb.lottie.LottieAnimationView dan taruh file JSON di res/raw/. -->
            <ProgressBar
                android:id="@+id/progressLoading"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="34dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/tvSplashLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.2"
                android:text="@string/splash_loading"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
