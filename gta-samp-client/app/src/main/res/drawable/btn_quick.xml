<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol aksi cepat roleplay (pill gelap dengan garis emas) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33F5B301">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC141B26" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_stroke" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</ripple>
